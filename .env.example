# Server only. Never use NEXT_PUBLIC_ for these keys.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
# Optional. DeepSeek models default to https://api.deepseek.com;
# other models default to https://api.openai.com/v1.
LLM_BASE_URL=
# DeepSeek only: disabled by default for short structured planning steps.
LLM_THINKING=disabled
AMAP_KEY=
# Browser-visible JS API key. Restrict it with an Amap domain whitelist.
NEXT_PUBLIC_AMAP_JS_KEY=
# Server-only security code used by /_AMapService. Never prefix with NEXT_PUBLIC_.
AMAP_JS_SECURITY_CODE=
