# Daymark v1 environment template
# Copy this file to .env.local or .env before running the app.
# Keep secrets server-only. Never expose them to the browser.

# App and auth
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Postgres / Supabase
# Runtime (Drizzle): transaction-mode pooler. Use prepare: false in the client.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migrations (drizzle-kit): direct connection.
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# External provider: Geoapify for places, routes, and geocoding
GEOAPIFY_API_KEY=

# Groq LLM for trip planning (server-only)
GROQ_API_KEY=
GROQ_MODEL=
# Optional; defaults to https://api.groq.com/openai/v1.
GROQ_BASE_URL=

# TypeSafe Jev — System One decision model (server-only)
# Get your key from console.typesafe.ai or JevStation (https://jevstation.com)
# Key begins with sk_   Env var name: JEV_API_KEY
JEV_API_KEY=
# Optional: pin a specific Jev model version (default: jev-latest)
# JEV_MODEL=jev-1.13
#
# JEV_BASE_URL controls which provider handles Jev calls:
#
#   Free testing — Hack Club AI proxy (no card, $3/day):
#     1. Create a free key at https://ai.hackclub.com (dashboard → new key)
#     2. Set JEV_API_KEY to your Hack Club key
#     3. Set JEV_BASE_URL=https://ai.hackclub.com/proxy/v1/jev
#
#   Production — TypeSafe directly ($0.042/M input tokens, output free):
#     Set JEV_BASE_URL=https://api.typesafe.ai  (or leave blank — default)
#
JEV_BASE_URL=

# Notes:
# - Keep SUPABASE_SECRET_KEY and GOOGLE_CLIENT_SECRET server-only.
# - Only public browser-safe values should use the NEXT_PUBLIC_ prefix.
